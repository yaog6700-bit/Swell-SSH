<Page
    x:Class="SwellSSH.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SwellSSH.Pages"
    xmlns:controls="using:SwellSSH.Controls"
    xmlns:models="using:SwellSSH.Models"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SidebarGroupTemplate" x:DataType="local:ConnectionGroupViewModel">
            <Grid Padding="8,12,0,4" Background="Transparent" Tapped="GroupHeader_Tapped" BackgroundSizing="InnerBorderEdge">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="10" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="local:ConnectionItemViewModel">
            <Grid Padding="8,8,4,8" ColumnSpacing="10" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="连接" Click="ConnectMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="编辑" Click="EditMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="删除" Click="DeleteMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="{x:Bind FavoriteMenuText, Mode=OneWay}" Click="ToggleFavoriteMenu_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="{x:Bind FavoriteMenuIcon, Mode=OneWay}"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="18"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind DisplayHostPort, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <!-- Monitoring stats row -->
                    <TextBlock Text="{x:Bind StatsText, Mode=OneWay}"
                               Visibility="{x:Bind IsMonitoringVisible, Mode=OneWay}"
                               FontSize="10"
                               Opacity="0.65"
                               FontFamily="Consolas"
                               Margin="0,1,0,0"/>
                </StackPanel>
                <!-- IP 遮罩切换按钮 -->
                <Button Grid.Column="2"
                        Width="28" Height="28" Padding="0"
                        Background="Transparent" BorderBrush="Transparent"
                        CornerRadius="4"
                        ToolTipService.ToolTip="显示/隐藏 IP 地址"
                        Click="ToggleIpVisibility_Click">
                    <FontIcon Glyph="{x:Bind EyeGlyph, Mode=OneWay}" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>

        <local:SidebarTemplateSelector x:Key="SidebarTemplateSelector"
            GroupTemplate="{StaticResource SidebarGroupTemplate}"
            ItemTemplate="{StaticResource SidebarItemTemplate}" />
    </Page.Resources>

    <Grid>
        <!-- Terminal TabView & Sidebar (full width) -->
        <Grid>
            <SplitView x:Name="TerminalSplitView" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="260" IsPaneOpen="False" PaneBackground="Transparent"
                       PaneClosed="TerminalSplitView_PaneClosed">
                <SplitView.Content>
                    <Grid>
                        <TabView
                            x:Name="TerminalTabView"
                            AddTabButtonClick="TerminalTabView_AddTabButtonClick"
                            TabCloseRequested="TerminalTabView_TabCloseRequested"
                            SizeChanged="TerminalTabView_SizeChanged"
                            VerticalAlignment="Stretch">
                            <!-- Spacer in tab strip to avoid overlapping with title bar buttons -->
                            <TabView.TabStripHeader>
                                <Border Width="88" />
                            </TabView.TabStripHeader>
                            <TabView.TabStripFooter>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="0,0,4,0">
                                    <Button x:Name="AiButton" Style="{ThemeResource AccentButtonStyle}" Padding="6,4" ToolTipService.ToolTip="AI Assistant" Click="AiButton_Click">
                                        <FontIcon Glyph="&#xE99A;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </TabView.TabStripFooter>
                        </TabView>

                        <!-- Empty state when no tabs -->
                        <Grid
                            x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560"
                            Padding="24">
                            <StackPanel Spacing="18">
                                <FontIcon Glyph="&#xE8C8;"
                                          FontSize="56"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="开始 SSH 会话"
                                               Style="{ThemeResource TitleTextBlockStyle}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="输入临时地址快速连接，或新建一个常用连接。"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="EmptyQuickConnectBox"
                                             PlaceholderText="user@host:port"
                                             FontFamily="Consolas"
                                             KeyDown="EmptyQuickConnectBox_KeyDown"/>
                                    <Button Grid.Column="1"
                                            MinWidth="92"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Click="EmptyQuickConnectButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                            <TextBlock Text="连接"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Center">
                                    <Button Click="EmptyAddConnectionButton_Click"
                                            MinWidth="116">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                            <TextBlock Text="新建连接"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="EmptyNewSftpButton_Click"
                                            MinWidth="116">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                            <TextBlock Text="新建SFTP"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="EmptyOpenConnectionsButton_Click"
                                            MinWidth="132">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                            <TextBlock Text="展开连接列表"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </SplitView.Content>

                <SplitView.Pane>
                    <Grid x:Name="SidebarPaneGrid" Margin="0,28,0,0" Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="1,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Top Tab Bar -->
                        <Grid Grid.Row="0" Margin="16,16,16,8" Height="36" Background="{ThemeResource SidebarTabBarBackgroundBrush}" CornerRadius="6" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Tab 0: Snippets -->
                            <ToggleButton x:Name="TabSnippetsButton" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="0">
                                <FontIcon Glyph="&#xE943;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ToggleButton>

                            <!-- Tab 1: History (Placeholder) -->
                            <ToggleButton x:Name="TabHistoryButton" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="1">
                                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ToggleButton>

                            <!-- Tab 2: Themes -->
                            <ToggleButton x:Name="TabThemesButton" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Background="Transparent" CornerRadius="6" Click="SidebarTabButton_Click" Tag="2">
                                <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <!-- Views Container -->
                        <Grid Grid.Row="1">
                            <!-- View 0: Snippets -->
                            <Grid x:Name="SidebarSnippetsView" Visibility="Collapsed" Margin="16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="+ 新建代码片段" Click="NewSnippetButton_Click" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Margin="0,0,0,16"/>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind Snippets, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="RootBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemHoverBrush}"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SnippetViewModel">
                                            <Grid Margin="0,8" ColumnSpacing="8">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="编辑" Click="EditSnippet_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="删除" Click="DeleteSnippet_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Command}" FontFamily="Consolas" Opacity="0.6" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                                                        ToolTipService.ToolTip="运行代码片段" Click="RunSnippet_Click">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- View 1: History -->
                            <Grid x:Name="SidebarHistoryView" Visibility="Collapsed">
                                <TextBlock Text="历史记录模块开发中..." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            </Grid>

                            <!-- View 2: Themes -->
                            <Grid x:Name="SidebarThemesView" Visibility="Collapsed" Margin="16,0,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="10" Margin="0,4,0,12">
                                    <TextBlock Text="SSH 字体" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <ComboBox x:Name="SidebarFontFamilyCombo" HorizontalAlignment="Stretch"
                                              PlaceholderText="选择终端字体"
                                              SelectionChanged="SidebarFontFamily_SelectionChanged"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字体大小" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <NumberBox x:Name="SidebarFontSizeBox" Grid.Column="1" Minimum="10" Maximum="32"
                                                   SmallChange="1" SpinButtonPlacementMode="Compact"
                                                   ValueChanged="SidebarFontSize_ValueChanged"/>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource SidebarBorderBrush}" Margin="0,2"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="主题" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="新建主题" Click="NewTerminalTheme_Click" Padding="12,5"/>
                                    </Grid>
                                </StackPanel>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind Themes, Mode=OneWay}" SelectionMode="Single" SelectionChanged="SidebarThemesList_SelectionChanged" Margin="-8,0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="8"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="RootBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemHoverBrush}"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Selected">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemSelectedBrush}"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                    <VisualState x:Name="SelectedPointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemSelectedBrush}"/>
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ThemeViewModel">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Mini Terminal Preview -->
                                                <Border Grid.Column="0" Width="60" Height="40" Background="{x:Bind BgBrush}" CornerRadius="6" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="1" Padding="6,8">
                                                    <StackPanel Spacing="4">
                                                        <Rectangle Height="4" Fill="{x:Bind Accent1Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="40"/>
                                                        <Rectangle Height="4" Fill="{x:Bind Accent2Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="30"/>
                                                        <Rectangle Height="4" Fill="{x:Bind Accent3Brush}" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="20"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Theme Name -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>
                </SplitView.Pane>
            </SplitView>
            
            <!-- AI Assistant Pane (Overlay Right) -->
            <Grid x:Name="AiPaneContainer" Margin="0,28,0,0" HorizontalAlignment="Right" Width="350" Visibility="Collapsed" Background="{ThemeResource SidebarBackgroundBrush}">
                <!-- Shadow applied by wrapping if needed, but Border is enough for now -->
                <controls:AIAssistantPane x:Name="AiPane" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>

            <!-- ─ Settings Pane (Right side full coverage) ────────────────── -->
            <Grid x:Name="SettingsPaneHost" Visibility="Collapsed" Background="{ThemeResource SidebarBackgroundBrush}" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="RightSettingsHeader" Padding="24,0,24,0" BorderBrush="{ThemeResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="CloseSettingsPane_Click" Background="Transparent" BorderBrush="Transparent" Padding="8" Margin="0,0,16,0" ToolTipService.ToolTip="返回终端" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/> <!-- Back icon -->
                    </Button>
                    <TextBlock Grid.Column="1" Text="应用设置" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                </Grid>
                <Frame x:Name="SettingsPaneFrame" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Page>
