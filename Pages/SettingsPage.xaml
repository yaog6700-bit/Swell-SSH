<Page
    x:Class="SwellSSH.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SwellSSH.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Grid>
        <ScrollViewer Padding="24,16,24,24"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel MaxWidth="800"
                            HorizontalAlignment="Center"
                            Spacing="24">

            <!-- Search Box -->
            <AutoSuggestBox x:Name="SettingsSearchBox"
                            PlaceholderText="搜索设置项…"
                            QueryIcon="Find"
                            Width="350" HorizontalAlignment="Left"
                            TextChanged="SettingsSearchBox_TextChanged"/>

            <!-- No Results Hint -->
            <TextBlock x:Name="NoResultsText"
                       Text="没有匹配的设置项"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,16"
                       Visibility="Collapsed"/>

            <!-- Backdrop -->
            <StackPanel x:Name="BackdropSection" Spacing="12">
                <TextBlock Text="外观设置" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,16" Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="窗口背景材质" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="设置应用的窗口背景半透明特效" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <controls:Segmented Grid.Column="1" x:Name="BackdropSegmented" VerticalAlignment="Center" SelectionChanged="BackdropSegmented_SelectionChanged">
                            <controls:Segmented.Resources>
                                <SolidColorBrush x:Key="SegmentedItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="SegmentedItemBorderBrushPointerOver" Color="Transparent" />
                            </controls:Segmented.Resources>
                            <controls:SegmentedItem Content="Mica" FontSize="14" Padding="14,6">
                                <controls:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE706;" FontSize="16" />
                                </controls:SegmentedItem.Icon>
                            </controls:SegmentedItem>
                            <controls:SegmentedItem Content="Acrylic" FontSize="14" Padding="14,6">
                                <controls:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE708;" FontSize="16" />
                                </controls:SegmentedItem.Icon>
                            </controls:SegmentedItem>
                            <controls:SegmentedItem Content="None" FontSize="14" Padding="14,6">
                                <controls:SegmentedItem.Icon>
                                    <FontIcon Glyph="&#xE770;" FontSize="16" />
                                </controls:SegmentedItem.Icon>
                            </controls:SegmentedItem>
                        </controls:Segmented>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Font -->
            <StackPanel x:Name="FontSection" Spacing="12">
                <TextBlock Text="终端界面" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="550" HorizontalAlignment="Left">
                    <StackPanel>
                        <!-- Font Family -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,16">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="终端字体" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="选择终端面板中用于渲染文本的字体" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="FontFamilyCombo" Width="200" VerticalAlignment="Center" SelectionChanged="FontFamilyCombo_SelectionChanged"/>
                        </Grid>
                        
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0"/>
                        
                        <!-- Font Size -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,16">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="字体大小" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="调整终端面板中文字的显示大小" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="FontSizeSlider" Width="200" Minimum="10" Maximum="32" StepFrequency="1" VerticalAlignment="Center" ValueChanged="FontSizeSlider_ValueChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>



            <!-- Cursor -->
            <StackPanel x:Name="CursorSection" Spacing="12">
                <TextBlock Text="光标设置" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,16" Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="光标样式" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="选择终端中闪烁光标的形状" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <RadioButton x:Name="CursorBlock" Content="块状" GroupName="CursorStyle" IsChecked="True" Checked="CursorStyle_Checked" Tag="Block" Margin="0"/>
                            <RadioButton x:Name="CursorUnderline" Content="下划线" GroupName="CursorStyle" Checked="CursorStyle_Checked" Tag="Underline" Margin="0"/>
                            <RadioButton x:Name="CursorBar" Content="竖线" GroupName="CursorStyle" Checked="CursorStyle_Checked" Tag="Bar" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>




            <!-- AI Settings -->
            <StackPanel x:Name="AiSection" Spacing="12">
                <TextBlock Text="AI 助手" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Border Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="550" HorizontalAlignment="Left">
                    <StackPanel>
                        <!-- Environment -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,16">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="当前 API 环境" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="选择或配置用于响应的 AI 服务模型" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="管理 API 环境" Click="ManageAiEnvs_Click" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0"/>
                        
                        <!-- Context Line Count -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="16,16">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="附加上下文行数" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="发送给 AI 的终端最近输出行数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <NumberBox x:Name="AiContextLineBox" Grid.Column="1" Width="120" Minimum="0" Maximum="1000" VerticalAlignment="Center" SpinButtonPlacementMode="Compact" ValueChanged="AiContextLineBox_ValueChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Data Management -->
            <StackPanel x:Name="DataSection" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="数据管理" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="导出备份或从备份文件恢复全部连接配置与设置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Export -->
                <Border Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,16" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="导出备份" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="将全部连接、片段及设置打包为 .swellbak 文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ExportBackupButton" Grid.Column="1" Content="导出备份" Padding="12,5" CornerRadius="4" Click="ExportBackupButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Import -->
                <Border Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,16" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="恢复备份" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="从 .swellbak 文件恢复，将覆盖当前全部配置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ImportBackupButton" Grid.Column="1" Content="恢复备份" Padding="12,5" CornerRadius="4" Click="ImportBackupButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- About -->
            <StackPanel x:Name="AboutSection" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="关于 Swell SSH" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="现代化的 Windows SSH 客户端，使用 Win2D 硬件加速渲染与原生 WinUI 3 打造" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Top Info Card -->
                <Border Background="Transparent" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16,16"
                        Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Swell SSH" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <HyperlinkButton NavigateUri="https://github.com/yaog6700-bit/Swell-SSH" ToolTipService.ToolTip="GitHub" Padding="6" CornerRadius="4" MinWidth="0" MinHeight="0" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16">
                                        <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                                    </Viewbox>
                                </HyperlinkButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="AppVersionText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="(自适应 Fluent 原生版)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Image Grid.Column="1" Source="ms-appx:///Assets/tray-icon.ico" Width="72" Height="72" VerticalAlignment="Center" Stretch="Uniform" />
                    </Grid>
                </Border>

                <Border Background="Transparent" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" 
                        CornerRadius="8"
                        Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,16" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="客户端自动更新" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="检查是否有新版客户端发布" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="CheckAppUpdateButton" Grid.Column="1" Content="检查更新" Padding="12,5" CornerRadius="4" Click="CheckAppUpdateButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <Border Background="Transparent" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" 
                        CornerRadius="8"
                        Width="550" HorizontalAlignment="Left">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,16" ColumnSpacing="12">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="重置新手引导" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="清除引导完成标记，在下次启动应用时重新显示新手配置向导" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="ResetOnboardingButton" Grid.Column="1" Content="重置向导" Padding="12,5" CornerRadius="4" Click="ResetOnboardingButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
