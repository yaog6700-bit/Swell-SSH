<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SwellSSH.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Swell SSH">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- Theme transition overlay (circular wipe animation) -->
        <Grid x:Name="ThemeTransitionOverlay" Visibility="Collapsed"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="ThemeTransitionBackground" />
            <Image x:Name="ThemeTransitionImage" Stretch="None"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Grid>

        <!-- Main content wrapper — clip animation targets this -->
        <Grid x:Name="ContentWrapper">
            <NavigationView x:Name="MainNav"
                            PaneDisplayMode="LeftMinimal"
                            IsPaneOpen="False"
                            OpenPaneLength="300"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            AlwaysShowHeader="False"
                            Header=""
                            Background="Transparent">

                <NavigationView.PaneHeader>
                    <Grid Height="4" />
                </NavigationView.PaneHeader>

                <NavigationView.Resources>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="Transparent" />
                </NavigationView.Resources>

                <!-- Pane Custom Content: Connection list -->
                <NavigationView.PaneCustomContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="100"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Padding="16,8,16,4">
                            <TextBlock Text="SSH 连接" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>

                        <!-- Quick connect bar -->
                        <Grid Grid.Row="1" Padding="8,0,8,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PaneQuickConnectBox"
                                     PlaceholderText="快速连接 user@host:port"
                                     FontSize="12"
                                     KeyDown="PaneQuickConnectBox_KeyDown"/>
                            <Button Grid.Column="1"
                                    Width="32" Height="32" Padding="0"
                                    ToolTipService.ToolTip="连接"
                                    Click="PaneQuickConnectButton_Click">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Connection list -->
                        <ListView x:Name="PaneConnectionList"
                                  Grid.Row="2"
                                  Margin="0,4,0,0"
                                  SelectionMode="Single"
                                  DoubleTapped="PaneConnectionList_DoubleTapped">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="16,0,0,0"/>
                                    <Setter Property="MinHeight" Value="32"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="RootBorder"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemHoverBrush}"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemSelectedBrush}"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="SelectedPointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="RootBorder.Background" Value="{ThemeResource SidebarItemSelectedBrush}"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- Bottom toolbar -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Padding="8,4,8,8" Spacing="4" Visibility="Collapsed">
                            <Button x:Name="PaneAddConnectionButton" Click="PaneAddConnectionButton_Click"
                                    ToolTipService.ToolTip="新建连接" Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock Text="新建连接"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PaneEditConnectionButton" Click="PaneEditConnectionButton_Click"
                                    ToolTipService.ToolTip="编辑所选连接">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                            <Button x:Name="PaneDeleteConnectionButton" Click="PaneDeleteConnectionButton_Click"
                                    ToolTipService.ToolTip="删除所选连接">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </NavigationView.PaneCustomContent>

                <!-- Pane Footer: SFTP + Settings -->
                <NavigationView.PaneFooter>
                    <StackPanel Spacing="2" Padding="4,0,4,4">
                        <NavigationViewItem x:Name="SftpNavItem"
                                            Tapped="SftpNavItem_Tapped"
                                            Content="SFTP"
                                            Tag="sftp"
                                            ToolTipService.ToolTip="打开 SFTP 文件管理">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Name="SettingsNavItem"
                                            Tapped="SettingsNavItem_Tapped"
                                            Content="设置"
                                            Tag="settings"
                                            ToolTipService.ToolTip="应用设置"
                                            PointerEntered="SettingsNavItem_PointerEntered"
                                            PointerExited="SettingsNavItem_PointerExited">
                            <NavigationViewItem.Icon>
                                <FontIcon x:Name="SettingsNavIcon" Glyph="&#xE713;" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.InfoBadge>
                                <InfoBadge x:Name="UpdateBadge" Style="{ThemeResource AttentionIconInfoBadgeStyle}" Visibility="Collapsed" />
                            </NavigationViewItem.InfoBadge>
                        </NavigationViewItem>
                    </StackPanel>
                </NavigationView.PaneFooter>

                <NavigationView.MenuItems>
                </NavigationView.MenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- Global Sidebar Toggle Button: aligned to the left after hamburger menu -->
            <Button x:Name="GlobalToggleSidebarButton"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Width="36" Height="36"
                    Margin="48,6,0,0"
                    CornerRadius="4"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0"
                    Click="GlobalToggleSidebarButton_Click" ToolTipService.ToolTip="切换终端工具箱">
                <FontIcon Glyph="&#xE90D;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Button>

            <!-- Floating theme toggle, shown when the hamburger pane is open -->
            <Button x:Name="FloatingThemeToggleButton"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Width="36" Height="36"
                    Margin="252,6,0,0"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0"
                    Click="FloatingThemeToggleButton_Click"
                    ToolTipService.ToolTip="切换主题">
                <FontIcon x:Name="FloatingThemeToggleIcon"
                          Glyph="&#xE706;"
                          FontSize="18"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </Button>

            <!-- Drag region for custom title bar -->
            <Grid x:Name="AppTitleBar" Height="48" Background="Transparent"
                  IsHitTestVisible="False"
                  VerticalAlignment="Top"
                  Margin="0,0,140,0"/>

        </Grid>
        <!-- 新手引导遮罩层：懒加载，首次需要时才由代码注入 OnboardingControl 实例 -->
        <ContentControl x:Name="AppOnboardingHost" Visibility="Collapsed" Canvas.ZIndex="100"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
